* text=auto eol=lf

# Windows batch files need CRLF line endings to run reliably. Under `-text`, git
# converts no bytes on checkout or in `git archive`, so a .bat file ships as CRLF
# only when its blob holds CRLF. Guarded by
# .github/tests/test_launcher_line_endings.sh.
*.bat -text
*.cmd -text

# Shell/command launchers must stay LF
*.sh text eol=lf
*.command text eol=lf

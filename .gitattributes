* text=auto eol=lf

# Windows batch files need CRLF line endings to run reliably, also for users of
# the README's Download ZIP path. `-text` makes git keep a .bat file's bytes as
# committed, so the blob itself must hold CRLF. Guarded by
# .github/tests/test_launcher_line_endings.sh.
*.bat -text
*.cmd -text

# Shell/command launchers must stay LF
*.sh text eol=lf
*.command text eol=lf

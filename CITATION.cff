    given-names: Jeffrey M.
    orcid: "https://orcid.org/0000-0002-7359-3746"
repository-code: "https://github.com/jmgirard/rocker-bayes"
url: "https://github.com/jmgirard/rocker-bayes"
license: MIT
keywords:
